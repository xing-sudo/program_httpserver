## 头文件和源文件应该怎么写

例如拆 `Buffer`。

### `include/httpserver/base/buffer.h`

```cpp
#pragma once

#include <cstddef>
#include <string>
#include <vector>

namespace httpserver {

class Buffer {
public:
    explicit Buffer(std::size_t initial_size = 1024);

    std::size_t readableSize() const;
    std::size_t writableSize() const;

    char* readPos();
    const char* readPos() const;
    char* writePos();

    void moveReadPos(std::size_t length);
    void moveWritePos(std::size_t length);

    void write(const void* data, std::size_t length);
    void write(const std::string& data);

    std::string readAsString(std::size_t length);
    void clear();

private:
    void ensureSpace(std::size_t length);

private:
    std::size_t read_pos_;
    std::size_t write_pos_;
    std::vector<char> data_;
};

} // namespace httpserver
```

### `src/base/buffer.cpp`

```cpp
#include "httpserver/base/buffer.h"

#include <algorithm>
#include <cassert>
#include <cstring>

namespace httpserver {

Buffer::Buffer(std::size_t initial_size)
    : read_pos_(0),
      write_pos_(0),
      data_(initial_size) {
}

std::size_t Buffer::readableSize() const {
    return write_pos_ - read_pos_;
}

std::size_t Buffer::writableSize() const {
    return data_.size() - write_pos_;
}

// 其他成员函数定义放在这里

} // namespace httpserver
```

每个 `.cpp` 文件都应该首先包含自己的头文件：

```cpp
